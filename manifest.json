{
	"manifest_version": 3,
	"name": "Chloride Browser Extension",
	"version": "1.0.0",
	"description": "Native Chloride Protocol canvas runtime for Firefox.",
	"browser_specific_settings": {
		"gecko": {
			"id": "chloride-firefox@superrealchlorine.com",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"permissions": [
		"webRequest",
		"nativeMessaging"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	},
	"protocol_handlers": [
		{
			"protocol": "ext+chloride",
			"name": "Chloride Protocol",
			"uriTemplate": "viewer.html?target=%s"
		}
	],
	"action": {
		"default_title": "Chloride Protocol Viewer",
		"default_popup": "viewer.html"
	}
}
